{
  "code_python": {
    "prefix": ["code_python"],
    "body": ["```{python}", "${1:code}", "```"]
  },
  "code_python_extr": {
    "prefix": ["code_python_extr"],
    "body": [
      "```{python}",
      "#| echo: false ",
      "#| code-fold: false",
      "#| code-summary: \"text to show when folded\"",
      "#| label: ",
      "#| fig-cap: 'caption'",
      "#| fig-alt: ",
      "#| fig-height: 1.5",
      "#| fig-width: 6",
      "${1:code}",
      "```"
    ]
  },
  "bashcode": {
    "prefix": ["code_bash"],
    "body": ["```{bash} ", "$1", "```"]
  },
  "code": {
    "prefix": ["code"],
    "body": ["```{$1} ", "$2", "```", "$0"]
  },
  "pyfig2": {
    "prefix": ["code_py_fig_2cols"],
    "body": [
      "```python ",
      "#| label: fig-$1",
      "#| fig-cap: \"$2\"",
      "#| fig-subcap: ",
      "#|    - \"$3\"",
      "#|    - \"$4\"",
      "#| layout-ncol: 2",
      "",
      "import numpy as np",
      "import matplotlib.pyplot as plt",
      "plt.style.use(['science', 'ieee'])",
      "$5",
      "plt.legend()",
      "plt.show()",
      "",
      "$6",
      "plt.legend()",
      "plt.show()",
      "```"
    ]
  },
  "ipython_interactive": {
    "prefix": ["ipyinteractive"],
    "body": [
      "```python",
      "from IPython.core.getipython import get_ipython",
      "ip = get_ipython()",
      "interactive = False",
      "if ip is not None and 'interactiveshell.TerminalInteractiveShell' in str(ip):",
      "  interactive = True",
      "```"
    ]
  }
}
