{
  "cabecera": {
    "prefix": "_yaml_md",
    "body": [
      "---",
      "title: \"${1:Title}\" ",
      "subtitle: \"${2:Subtitle}\"",
      "author: \"${3:Fernando Andres-Pretel}\"",
      "titlepage: true",
      "toc: true",
      "toc-depth: 3",
      "number-offset: 1",
      "secnumberdepth: 1",
      "number-sections: false",
      "number-depth: 4",
      "colorlinks: true",
      "mainfont: DejaVu Sans",
      "mathfont: DejaVu Math TeX Gyre",
      "monofont: Source Code Pro",
      "fontsize: 12pt",
      "highlight-style: tango",
      "code-block-font-size: \\footnotesize",
      "code-block-font-size: \\scriptsize",
      "header-includes:",
      "- |",
      "  ```{=latex}",
      "  \\usepackage{awesomebox}",
      "  \\providecommand{\\pandocbounded}[1]{#1}",
      "  ```",
      "pandoc-latex-environment:",
      "  noteblock: [note]",
      "  tipblock: [tip]",
      "  warningblock: [warning]",
      "  cautionblock: [caution]",
      "  importantblock: [important]",
      "---",
      "${4:Text}"
    ],
    "description": "Cabecera básica yaml para md"
  },
  "yaml_pdf": {
    "prefix": "_yaml_pdf",
    "body": [
      "pdf:",
      "   documentclass: \"article\"",
      "   titlepage: true",
      "   toc: true",
      "   toc-depth: 3",
      "   numbersections: false",
      "   number-depth: 4",
      "   number-offset: 1",
      "   secnumberdepth: 1",
      "   colorlinks: true",
      "   mainfont: DejaVu Sans",
      "   mathfont: DejaVu Math TeX Gyre",
      "   monofont: Source Code Pro",
      "   geometry: a4paper",
      "   geometry: margin=2cm",
      "   fontsize: 12pt",
      "   code-block-font-size: \\scriptsize"
    ],
    "description": "YAML pdf section"
  },
  "yaml_quarto": {
    "prefix": "_yaml_quarto",
    "body": [
      "---",
      "title: \"${1:title}\"",
      "subtitle: \"${2:subtitle}\"",
      "author: \"Fernando Andres-Pretel\"",
      "format:",
      "  html:",
      "    toc: true",
      "    code-fold: true",
      "    number-sections: true",
      "    number-offset: 1",
      "    shift-heading-level-by: -1",
      "    embed-resources: true",
      "    self-contained-math: true",
      "jupyter:",
      "  jupytext:",
      "    text_representation:",
      "      extension: .qmd",
      "      format_name: quarto",
      "      format_version: \"1.0\"",
      "      jupytext_version: 1.16.6",
      "  kernelspec:",
      "    display_name: Python 3",
      "    language: python",
      "    name: python3",
      "---"
    ],
    "description": "YAML header full"
  },
  "yaml_revealjs": {
    "prefix": "_yaml_revealjs",
    "body": [
      "---",
      "title: \"${1:title}\"",
      "subtitle: \"${2:subtitle}\"",
      "author: \"Fernando Andres-Pretel\"",
      "output:",
      "  revealjs::revealjs_presentation:",
      "    theme: \"sky\"",
      "    self_contained: false",
      "    css: \"assets/custom.css\"",
      "reveal_options:",
      "  backgroundTransition: fade",
      "---"
    ],
    "description": "YAML header full"
  }
}
