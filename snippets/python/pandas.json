  "pd_load_data": {
    "prefix": ["pd_load_data"],
    "body": [
      "data = sns.load_dataset(\"mpg\")",
      "data = pd.read_csv(\"${1:path/to/file}\") # load csv file",
      "data = pd.read_excel(\"${1:path/to/file}\") # load xlsx file",
      ""
    ],
    "description": ["load data using pandas"]
  },
  "pd_desc_num": {
    "prefix": ["pd_desc_num"],
    "body": [
      "data.describe() # describe all num variables of the data.frame",
      "data_col = data[\"${1:col_name}\"].describe()",
      "data_col = data[[\"${1:col_name}\", \"sepal_length\"]].describe()",
      "data_col = data[data[\"filter_col_name\"] == \"filter_value\"][\"${1:col_name}\"].describe()",
      "data_col = data.groupby(\"species\")[\"sepal_width\"].median() # median of width by species",
      "shapiro_stat, shapiro_p = scipy.stats.shapiro(data[\"${1:col_name}\"])",
      "print(\"Shapiro test: {0} - p: {1}\".format(shapiro_stat, shapiro_p))"
    ],
    "description": ["describe numeric variables"]
  },
  "pd_desc_cat_1": {
    "prefix": ["pd_desc_cat_1"],
    "body": [
      "${1:df}.columns # col names",
      "${1:df}[\"${2:column}\"].value_counts() # count values",
      "freq=pd.crosstab(${1:df}[\"${2:column}\"], columns=\"count\")",
      "prop=pd.crosstab(${1:df}[\"${2:column}\"], normalize=True, columns=\"count\")",
      "combined = freq.astype(str) + \" (\" + (prop * 100).round(1).astype(str) + \"%)\"",
      "print(combined)"  
    ],
    "description": ["describe categoric variable"]
  },
  "pd_desc_cat_2": {
    "prefix": ["pd_desc_cat_2"],
    "body": [
      "${1:df}.columns # col names",
      "freq=pd.crosstab(index=${1:df}[\"${2:column}\"], columns=${1:df}[\"${3:column}\"])",
      "prop=pd.crosstab(index=${1:df}[\"${2:column}\"], columns=${1:df}[\"${3:column}\"], normalize=\"columns\")",
      "combined = freq.astype(str) + \" (\" + (prop * 100).round(1).astype(str) + \"%)\"",
      "print(combined)"  
    ],
    "description": ["describe two categoric variables"]
  },
  "pd_categorize": {
    "prefix": ["pd_categorize"],
    "body": [
      "${1:df}[\"${2:new_column}\"]=${1:df}[\"${3:column}\"] > ${4:value}",
      "${1:df}[\"${2:new_column}\"]=${1:df}[\"${2:new_column}\"].map({False:\"no\", True:\"yes\"}).astype(\"category\")"
    ],
    "description": ["categorize a numeric variable"]
  },


