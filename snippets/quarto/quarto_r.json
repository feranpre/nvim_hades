{
  "rcode": {
    "prefix": "rcode",
    "body": [
      "```{r} ",
      "#| echo: false ",
      "#| eval: true",
      "#| results: 'asis'",
      "#| comment: ''",
      "$1",
      "```"
    ],
    "description": "r code"
  },
  "rchunk": {
    "prefix": "rchunk",
    "body": [
      "```{r}",
      "#| echo: false ",
      "#| results: 'asis'",
      "$1",
      "```"
    ],
    "description": "rchunk"
  },
  "rfig": {
    "prefix": "rfig",
    "body": [
      "```{r}",
      "#| label: fig-${1:nombre}",
      "#| fig-cap: \"${2:Título de la figura}\"",
      "${0:plot()}",
      "```"
    ],
    "description": "Figura numerada (citar con @fig-nombre)"
  },
  "new page": {
    "prefix": "new_page",
    "body": [
      "\\newpage"
    ],
    "description": "latex new page"
  },
  "small": {
    "prefix": "small",
    "body": [
      "\\begingroup\\small",
      "$1",
      "\\endgroup"
    ],
    "description": "font resize (latex)"
  },
  "tiny": {
    "prefix": "tiny",
    "body": [
      "\\begingroup\\tiny",
      "$1",
      "\\endgroup"
    ],
    "description": "font resize (latex)"
  },
  "tbl-create": {
    "prefix": "tbl-create",
    "body": [
      "::: {#tbl-${1:nombre_tabla}}",
      "TABLA",
      "${2:titulo_tabla}",
      ":::"
    ],
    "description": "insert table caption for later reference"
  },
  "informe": {
    "prefix": "informe",
    "body": [
      "---",
      "title: \"${1:Título del informe}\"",
      "author: \"Fernando Andrés-Pretel\"",
      "date: today",
      "date-format: \"DD/MM/YYYY\"",
      "toc: true",
      "number-sections: true",
      "fig-width: 7",
      "fig-height: 4.5",
      "execute:",
      "  echo: false",
      "  message: false",
      "  warning: false",
      "  error: true",
      "---",
      "",
      "```{r}",
      "#| label: setup",
      "#| include: false",
      "library(feR)",
      "",
      "# Mostrar los resultados de feR como tablas en el informe sin results = 'asis'",
      "# (quitar cuando feR traiga su propio método knit_print)",
      "registerS3method(\"knit_print\", \"feR\", function(x, ...) {",
      "  knitr::asis_output(paste(utils::capture.output(print(x)), collapse = \"\\n\"))",
      "}, envir = asNamespace(\"knitr\"))",
      "",
      "load(\"DATOS_R/DATOS.RData\")",
      "```",
      "",
      "# ${2:Descripción de la muestra}",
      "",
      "$0"
    ],
    "description": "Cabecera de informe con feR, lista para exportar con ,ep / ,eh"
  },
  "compare_vars": {
    "prefix": "compare_vars",
    "body": [
      "```{r}",
      "#| results: asis",
      "vars <- c(${1:\"EDAD\", \"SEXO\"})",
      "for (v in vars) {",
      "  # do.call: feR reevalúa los argumentos y falla con DATOS[[v]] dentro de knitr",
      "  print(do.call(compare, list(DATOS[[v]], y = DATOS[[\"${2:GRUPO}\"]], x_name = v, y_name = \"${3:${2}}\")))",
      "}",
      "```",
      "$0"
    ],
    "description": "feR: comparar varias variables con un grupo"
  },
  "rtbl": {
    "prefix": "rtbl",
    "body": [
      "```{r}",
      "#| label: tbl-${1:nombre}",
      "#| tbl-cap: \"${2:Título de la tabla}\"",
      "knitr::kable(${0:df}, digits = 2)",
      "```"
    ],
    "description": "Tabla numerada (citar con @tbl-nombre)"
  }
}
