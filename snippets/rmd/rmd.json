{
  "informe": {
    "prefix": "informe",
    "body": [
      "---",
      "title: \"${1:Título del informe}\"",
      "author: \"Fernando Andrés-Pretel\"",
      "date: today",
      "date-format: \"DD/MM/YYYY\"",
      "toc: true",
      "toc-depth: ${2:3}",
      "number-sections: true",
      "fig-width: 7",
      "fig-height: 4.5",
      "format:",
      "  html:",
      "    toc-location: left",
      "    toc-expand: true",
      "    embed-resources: true",
      "  pdf: default",
      "execute:",
      "  echo: false",
      "  message: false",
      "  warning: false",
      "  error: true",
      "---",
      "",
      "```{r}",
      "#| label: setup",
      "#| include: false",
      "library(feR)",
      "",
      "# Mostrar los resultados de feR como tablas en el informe sin results = 'asis'",
      "# (quitar cuando feR traiga su propio método knit_print)",
      "registerS3method(\"knit_print\", \"feR\", function(x, ...) {",
      "  knitr::asis_output(paste(utils::capture.output(print(x)), collapse = \"\\n\"))",
      "}, envir = asNamespace(\"knitr\"))",
      "",
      "load(\"DATOS_R/DATOS.RData\")",
      "```",
      "",
      "# ${3:Descripción de la muestra}",
      "",
      "$0"
    ],
    "description": "Cabecera de informe (se exporta con quarto: ,ep / ,eh)"
  }
}
