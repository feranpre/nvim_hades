{
  "yaml_rmd_pdf": {
    "prefix": "yaml_rmd_pdf",
    "body": [
      "---",
      "Title: \"${1:Title}\"",
      "Author: \"Fernando Andres-Pretel\"",
      "Titlepage: true",
      "Fontsize: 12pt",
      "Geometry: margin=2cm",
      "Mainfont: DejaVu Sans",
      "Mathfont: DejaVu Math TeX Gyre",
      "Monofont: Source Code Pro",
      "Self_contained: true",
      "Output:",
      "  pdf_document:",
      "    toc: true",
      "    toc_depth: 3",
      "    number_sections: false",
      "    latex_engine: xelatex",
      "---"
    ],
    "description": "YAML header for Rmd to PDF"
  }
}
