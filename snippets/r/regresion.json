{
  "_reg_lineal": {
    "prefix": "_reg_lineal",
    "body": [
      "# La primera variable es la dependiente",
      "vars <- c(${2:\"Y\", \"X1\", \"X2\"})",
      "reg_lin(${1:datos}[, vars])",
      "$0"
    ],
    "description": "feR: regresión lineal (pasos, diagnósticos, R2)"
  },
  "_reg_lineal__base": {
    "prefix": "_reg_lineal__base",
    "body": [
      "# La primera variable es la dependiente",
      "vars <- c(${2:\"Y\", \"X1\", \"X2\"})",
      "d <- na.omit(${1:DATOS}[, vars])",
      "formula <- reformulate(vars[-1], response = vars[1])",
      "",
      "saturado <- lm(formula, data = d)",
      "modelo <- step(saturado, direction = \"both\", trace = 0)",
      "summary(modelo)",
      "confint(modelo)",
      "",
      "# Diagnósticos: residuos, normalidad, influyentes y colinealidad",
      "par(mfrow = c(2, 2)); plot(modelo); par(mfrow = c(1, 1))",
      "shapiro.test(residuals(modelo))",
      "# car::vif(modelo)",
      "$0"
    ],
    "description": "R base: regresión lineal múltiple con selección por pasos y diagnósticos"
  },
  "_reg_log_bin": {
    "prefix": "_reg_log_bin",
    "body": [
      "# La primera variable es la dependiente (dicotómica)",
      "vars <- c(${2:\"Y\", \"X1\", \"X2\"})",
      "reg_log_bin(${1:datos}[, vars])",
      "$0"
    ],
    "description": "feR: regresión logística binaria (OR, pasos, ROC)"
  },
  "_reg_log_bin__base": {
    "prefix": "_reg_log_bin__base",
    "body": [
      "# La primera variable es la dependiente (dicotómica); la referencia es el primer nivel",
      "vars <- c(${2:\"Y\", \"X1\", \"X2\"})",
      "d <- na.omit(${1:DATOS}[, vars])",
      "d[[vars[1]]] <- factor(d[[vars[1]]])",
      "levels(d[[vars[1]]])",
      "formula <- reformulate(vars[-1], response = vars[1])",
      "",
      "saturado <- glm(formula, data = d, family = binomial)",
      "modelo <- step(saturado, direction = \"both\", trace = 0)",
      "summary(modelo)",
      "",
      "# Odds ratios con IC 95%",
      "round(exp(cbind(OR = coef(modelo), confint(modelo))), 3)",
      "",
      "# Capacidad de discriminación (AUC) y calibración",
      "# pROC::auc(d[[vars[1]]], fitted(modelo))",
      "# ResourceSelection::hoslem.test(as.numeric(d[[vars[1]]]) - 1, fitted(modelo))",
      "$0"
    ],
    "description": "R base: regresión logística binaria con OR, selección por pasos y AUC"
  },
  "_reg_ordinal": {
    "prefix": "_reg_ordinal",
    "body": [
      "# La primera variable es la dependiente (ordinal)",
      "vars <- c(${2:\"Y\", \"X1\", \"X2\"})",
      "reg_ord(${1:datos}[, vars])",
      "$0"
    ],
    "description": "feR: regresión ordinal (odds proporcionales)"
  },
  "_reg_ordinal__base": {
    "prefix": "_reg_ordinal__base",
    "body": [
      "# La primera variable es la dependiente (ordinal)",
      "vars <- c(${2:\"Y\", \"X1\", \"X2\"})",
      "d <- na.omit(${1:DATOS}[, vars])",
      "d[[vars[1]]] <- factor(d[[vars[1]]], ordered = TRUE)",
      "formula <- reformulate(vars[-1], response = vars[1])",
      "",
      "modelo <- MASS::polr(formula, data = d, Hess = TRUE)",
      "summary(modelo)",
      "round(exp(cbind(OR = coef(modelo), confint(modelo))), 3)",
      "# Odds proporcionales: brant::brant(modelo)",
      "$0"
    ],
    "description": "MASS: regresión ordinal (odds proporcionales)"
  },
  "_reg_cox": {
    "prefix": "_reg_cox",
    "body": [
      "vars <- c(${2:\"X1\", \"X2\"})",
      "reg_cox(${1:datos}[, vars], time = ${1}[[\"${3:TIEMPO}\"]], y = ${1}[[\"${4:EVENTO}\"]])",
      "$0"
    ],
    "description": "feR: regresión de Cox"
  },
  "_reg_cox__base": {
    "prefix": "_reg_cox__base",
    "body": [
      "library(survival)",
      "modelo <- coxph(Surv(${2:TIEMPO}, ${3:EVENTO}) ~ ${4:X1 + X2}, data = ${1:DATOS})",
      "summary(modelo)",
      "cox.zph(modelo)   # riesgos proporcionales (p > 0.05: se cumple)",
      "$0"
    ],
    "description": "survival: regresión de Cox con HR y supuesto de riesgos proporcionales"
  },
  "_reg": {
    "prefix": "_reg",
    "body": [
      "regression(\"${2:Y ~ X1 + X2}\", ${1:datos}${3:, lang = \"es\"})",
      "$0"
    ],
    "description": "feR: regresión con el tipo elegido según la dependiente"
  }
}
