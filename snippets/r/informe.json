{
  "_informe": {
    "prefix": "_informe",
    "body": [
      "#' ---",
      "#' title: \"${1:Título del informe}\"",
      "#' author: \"Fernando Andrés-Pretel\"",
      "#' date: today",
      "#' date-format: \"DD/MM/YYYY\"",
      "#' toc: true",
      "#' toc-depth: ${2:3}",
      "#' number-sections: true",
      "#' fig-width: 7",
      "#' fig-height: 4.5",
      "#' format:",
      "#'   html:",
      "#'     toc-location: left",
      "#'     toc-expand: true",
      "#'     embed-resources: true",
      "#'   pdf: default",
      "#' execute:",
      "#'   echo: false",
      "#'   message: false",
      "#'   warning: false",
      "#'   error: true",
      "#' ---",
      "#'",
      "#+ setup, include = FALSE",
      "library(feR)",
      "defaults(lang = \"es\")",
      "",
      "# Mostrar los resultados de feR como tablas en el informe sin results = 'asis'",
      "# (quitar cuando feR traiga su propio método knit_print)",
      "registerS3method(\"knit_print\", \"feR\", function(x, ...) {",
      "  knitr::asis_output(paste(utils::capture.output(print(x)), collapse = \"\\n\"))",
      "}, envir = asNamespace(\"knitr\"))",
      "",
      "load(\"DATOS_R/datos.RData\")",
      "",
      "#' # ${3:Descripción de la muestra}",
      "#'",
      "$0"
    ],
    "description": "feR: cabecera de informe (.R con #') lista para exportar con ,ep / ,eh"
  },
  "_informe__base": {
    "prefix": "_informe__base",
    "body": [
      "#' ---",
      "#' title: \"${1:Título del informe}\"",
      "#' author: \"Fernando Andrés-Pretel\"",
      "#' date: today",
      "#' date-format: \"DD/MM/YYYY\"",
      "#' toc: true",
      "#' toc-depth: ${2:3}",
      "#' number-sections: true",
      "#' fig-width: 7",
      "#' fig-height: 4.5",
      "#' format:",
      "#'   html:",
      "#'     toc-location: left",
      "#'     toc-expand: true",
      "#'     embed-resources: true",
      "#'   pdf: default",
      "#' execute:",
      "#'   echo: false",
      "#'   message: false",
      "#'   warning: false",
      "#'   error: true",
      "#' ---",
      "#'",
      "#+ setup, include = FALSE",
      "load(\"DATOS_R/DATOS.RData\")",
      "",
      "#' # ${3:Descripción de la muestra}",
      "#'",
      "$0"
    ],
    "description": "R base: cabecera de informe (.R con #') lista para exportar con ,ep / ,eh"
  },
  "_seccion": {
    "prefix": "_seccion",
    "body": [
      "#'",
      "#' ## ${1:Título}",
      "#'",
      "#' ${2:Texto}",
      "#'",
      "$0"
    ],
    "description": "Nueva sección con texto"
  },
  "_texto": {
    "prefix": "_texto",
    "body": [
      "#'",
      "#' ${1:Texto}",
      "#'",
      "$0"
    ],
    "description": "Bloque de texto #'"
  },
  "_fig": {
    "prefix": "_fig",
    "body": [
      "#+",
      "#| label: fig-${1:nombre}",
      "#| fig-cap: \"${2:Título de la figura}\"",
      "${0:plot()}"
    ],
    "description": "Figura numerada (citar en el texto con @fig-nombre)"
  },
  "_tabla": {
    "prefix": "_tabla",
    "body": [
      "#+",
      "#| label: tbl-${1:nombre}",
      "#| tbl-cap: \"${2:Título de la tabla}\"",
      "knitr::kable(${0:df}, digits = 2)"
    ],
    "description": "Tabla numerada (citar en el texto con @tbl-nombre)"
  },
  "_chunk": {
    "prefix": "_chunk",
    "body": [
      "#+ results = \"asis\", echo = FALSE, comment = ''",
      "$0"
    ],
    "description": "Chunk básico: results = 'asis', sin código ni ##"
  },
  "_asis": {
    "prefix": "_asis",
    "body": [
      "#+ results = 'asis'",
      "$0"
    ],
    "description": "Chunk cuya salida es markdown (p. ej. cat() o print() de feR dentro de un bucle)"
  },
  "_nota": {
    "prefix": "_nota",
    "body": [
      "#' ::: {.${1|nota,resumen,ejemplo,definicion|}}",
      "#' ${2:Texto}",
      "#' :::",
      "$0"
    ],
    "description": "Caja de la plantilla (nota, resumen, ejemplo, definición)"
  },
  "_formula": {
    "prefix": "_formula",
    "body": [
      "#' \\$\\$",
      "#' ${1:H_0: \\\\mu_1 = \\\\mu_2}",
      "#' \\$\\$",
      "$0"
    ],
    "description": "Fórmula en bloque"
  }
}
