{
  "informe": {
    "prefix": "_informe",
    "body": [
      "#' ---",
      "#' title: \"${1:Título del informe}\"",
      "#' author: \"Fernando Andrés-Pretel\"",
      "#' date: today",
      "#' date-format: \"DD/MM/YYYY\"",
      "#' toc: true",
      "#' number-sections: true",
      "#' fig-width: 7",
      "#' fig-height: 4.5",
      "#' execute:",
      "#'   echo: false",
      "#'   message: false",
      "#'   warning: false",
      "#'   error: true",
      "#' ---",
      "#'",
      "#+ setup, include = FALSE",
      "library(feR)",
      "",
      "# Mostrar los resultados de feR como tablas en el informe sin results = 'asis'",
      "# (quitar cuando feR traiga su propio método knit_print)",
      "registerS3method(\"knit_print\", \"feR\", function(x, ...) {",
      "  knitr::asis_output(paste(utils::capture.output(print(x)), collapse = \"\\n\"))",
      "}, envir = asNamespace(\"knitr\"))",
      "",
      "load(\"DATOS_R/DATOS.RData\")",
      "",
      "#' # ${2:Descripción de la muestra}",
      "#'",
      "$0"
    ],
    "description": "Cabecera de informe (.R con #') lista para exportar con ,ep / ,eh"
  },
  "seccion": {
    "prefix": "_seccion",
    "body": [
      "#'",
      "#' ## ${1:Título}",
      "#'",
      "#' ${2:Texto}",
      "#'",
      "$0"
    ],
    "description": "Nueva sección con texto"
  },
  "texto": {
    "prefix": "_texto",
    "body": [
      "#'",
      "#' ${1:Texto}",
      "#'",
      "$0"
    ],
    "description": "Bloque de texto #'"
  },
  "figura": {
    "prefix": "_fig",
    "body": [
      "#+",
      "#| label: fig-${1:nombre}",
      "#| fig-cap: \"${2:Título de la figura}\"",
      "${0:plot()}"
    ],
    "description": "Figura numerada (citar en el texto con @fig-nombre)"
  },
  "tabla": {
    "prefix": "_tabla",
    "body": [
      "#+",
      "#| label: tbl-${1:nombre}",
      "#| tbl-cap: \"${2:Título de la tabla}\"",
      "knitr::kable(${0:df}, digits = 2)"
    ],
    "description": "Tabla numerada (citar en el texto con @tbl-nombre)"
  },
  "asis": {
    "prefix": "_asis",
    "body": [
      "#+ results = 'asis'",
      "$0"
    ],
    "description": "Chunk cuya salida es markdown (p. ej. print() de feR dentro de un bucle)"
  },
  "nota": {
    "prefix": "_nota",
    "body": [
      "#' ::: {.${1|nota,resumen,ejemplo,definicion|}}",
      "#' ${2:Texto}",
      "#' :::",
      "$0"
    ],
    "description": "Caja de la plantilla (nota, resumen, ejemplo, definición)"
  },
  "formula": {
    "prefix": "_formula",
    "body": [
      "#' \\$\\$",
      "#' ${1:H_0: \\\\mu_1 = \\\\mu_2}",
      "#' \\$\\$",
      "$0"
    ],
    "description": "Fórmula en bloque"
  },
  "compare_vars": {
    "prefix": "_compare_vars",
    "body": [
      "#+ results = 'asis'",
      "vars <- c(${1:\"EDAD\", \"SEXO\"})",
      "for (v in vars) {",
      "  # do.call: feR reevalúa los argumentos y falla con DATOS[[v]] dentro de knitr",
      "  print(do.call(compare, list(DATOS[[v]], y = DATOS[[\"${2:GRUPO}\"]], x_name = v, y_name = \"${3:${2}}\")))",
      "}",
      "$0"
    ],
    "description": "feR: comparar varias variables con un grupo"
  }
}
