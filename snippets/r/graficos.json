{
  "graph_save_tiff": {
    "prefix": ["_gg_save_tiff", "_img_tiff"],
    "body": [
      "tiff(file = \"./GRAFICOS/grafico_radar.tiff\",",
      "     width = 20, height = 20, units = \"cm\", res = 300)"
    ],
    "description": "Save a graph in tiff format"
  },
  "graph_save_png": {
    "prefix": ["_gg_save_png", "_img_png"],
    "body": [
      "ggsave(",
      "      filename = \"mi_grafico.png\",",
      "      plot     = g1,        # opcional; si lo omites usa el último gráfico",
      "      width    = 16,        # ancho",
      "      height   = 14,        # alto",
      "      units    = \"cm\",     # in, cm o mm",
      "      dpi      = 300       # resolución",
      "    )"
    ],
    "description": "Save a graph in tiff format"
  },

  "gg_boxplot": {
    "prefix": "_gg_boxplot",
    "body": [
      "ggplot(DATOS, aes(y = mpg, x = am, fill = am)) +",
      "  geom_violin(alpha = 0.3) +",
      "  geom_boxplot(width = 0.4, alpha = 0.5) +",
      "  geom_jitter(width = 0.1, alpha = 0.4, size = 5) +",
      "  stat_summary(fun.y = mean, show.legend = FALSE, geom = \"point\",",
      "               shape = 15, color = \"black\", size = 10) +",
      "  labs(x = \"automatic vs manual\", y = \"mpg\", fill = \"color\")"
    ],
    "description": "ggplot2 boxplot with stuff"
  },
  "gg_radar": {
    "prefix": "_gg_radar",
    "body": [
      "library(dplyr)",
      "group_var <- \"CENTRO_TRABAJO\"",
      "vars <- c(",
      "  \"D_APOYO_GESTOR\",",
      "  \"D_COMPANEROS\",",
      "  \"D_SERVICIO\",",
      "  \"D_INTENCIO_QUEDAR\",",
      "  \"D_CARGA_TRABAJO\"",
      ")",
      "min_ <- 0",
      "max_ <- 5",
      "var_names <- c(",
      "\"Apoyo gestor\",",
      "\"Compañeros\",",
      "\"Servicio\",",
      "\"Quedarse\",",
      "\"Carga Trabajo\"",
      ")",
      "grupos <- c(",
      "\"Albacete\",",
      "\"Valladolid\"",
      ")",
      "",
      "data <- DATOS %>%",
      "  group_by(.data[[group_var]]) %>%",
      "  summarise(",
      "    across(all_of(vars), ~ mean(.x, na.rm = TRUE), .names = \"{.col}\")",
      "  )",
      "",
      "data <- as.data.frame(data)",
      "names(data)[1] <- \"group\"",
      "data$group <- grupos ",
      "rownames(data) <- data$group",
      "data$group <- NULL",
      "names(data) <- var_names",
      "knitr::kable(as.data.frame(data))",
      "",
      "data <- rbind(rep(max_,ncol(data)), rep(min_,ncol(data)), data)",
      "rownames(data)[1:2] <- c(\"max\", \"min\")",
      "",
      "colors_border=c( rgb(0.2,0.5,0.5,0.9), rgb(0.8,0.2,0.5,0.9) , rgb(0.7,0.5,0.1,0.9) )",
      "colors_in=c( rgb(0.2,0.5,0.5,0.4), rgb(0.8,0.2,0.5,0.4) , rgb(0.7,0.5,0.1,0.4) )",
      "",
      "tiff(file=\"./GRAFICOS/grafico_radar.tiff\",",
      "width=20, height=20, units = \"cm\", res = 300)",
      "",
      "fmsb::radarchart(data  , axistype=1 ,",
      "    pcol=colors_border , pfcol=colors_in , plwd=4 , plty=1,",
      "    cglcol=\"grey\", cglty=1, axislabcol=\"grey\", caxislabels=seq(0,5,1), cglwd=0.8,",
      "    vlcex=0.8",
      "    )",
      "legend(x=0.7, y=1, legend = rownames(data[-c(1,2),]), bty = \"n\", pch=20 , col=colors_in , text.col = \"grey\", cex=1.2, pt.cex=3)",
      "",
      "dev.off()"
    ],
    "description": "ggplot2 radar graph"
  }
}
